# Local API development defaults.
#
# Copy to api/.env.local and choose one provider:
# - fake: no external model service; useful for smoke tests only
# - bedrock: local app with AWS Bedrock calls
LLM_PROVIDER=fake

# Required when LLM_PROVIDER=bedrock.
AWS_REGION=ap-southeast-2
BEDROCK_CHAT_MODEL_ID=apac.anthropic.claude-sonnet-4-20250514-v1:0

# Keep retrieval off for local agent development unless Postgres/pgvector and
# the embedding provider are available.
DEFAULT_USE_RETRIEVAL=false

# Safe local defaults so the API can import config without a database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
EMBED_DIM=1536

WORKSPACE_DIR=/tmp/claude-code-minimal-workspaces
MAX_WORKFLOW_ITERS=3
TEST_TIMEOUT_SECONDS=30
